<?xml version='1.0' encoding='utf-8'?>
<widget id="com.neon.chesshelper" version="1.1.0" xmlns="http://www.w3.org/ns/widgets">
    <name>Neon Chess</name>
    <description>Chess Assistant WebView</description>
    <author email="dev@local">Developer</author>
    <content src="index.html" />
    
    <!-- Benarkan navigasi penuh untuk pengesahan login / Cloudflare -->
    <allow-navigation href="*" />
    <access origin="*" />
    
    <preference name="DisallowOverscroll" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    
    <!-- Penting: Hilangkan tanda '; wv' supaya Chess.com tidak sekat login email -->
    <preference name="OverrideUserAgent" value="Mozilla/5.0 (Linux; Android 14; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Mobile Safari/537.36" />
</widget>
